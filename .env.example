# ==============================================================================
# ARCHGUARD MULTI-CLOUD STORAGE INTEGRATION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & API Ports
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
PORT=3001

# ------------------------------------------------------------------------------
# 1. Google Drive (Official OAuth 2.0 + Drive v3 API)
# Setup: Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID
# Scopes: https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/cloud/callback/google_drive

# ------------------------------------------------------------------------------
# 2. Microsoft OneDrive (Microsoft Identity + Microsoft Graph API v1.0)
# Setup: Azure Portal (portal.azure.com) -> Microsoft Entra ID -> App registrations
# Supported account types: Accounts in any organizational directory and personal Microsoft accounts
# Scopes: Files.ReadWrite User.Read offline_access
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/cloud/callback/onedrive

# ------------------------------------------------------------------------------
# 3. MEGA (Encrypted Session Architecture)
# Security: Zero plaintext password storage. Uses client-derived keys and token hashes.
# ------------------------------------------------------------------------------
MEGA_API_KEY=your_mega_app_key
MEGA_EMAIL=
MEGA_HASHED_SESSION=

# ------------------------------------------------------------------------------
# 4. Security & Encryption at Rest (AES-256-GCM)
# Generate a 32-byte (64 hex characters) key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=archguard_production_session_secret_2026
JWT_SECRET=archguard_production_jwt_signing_key_2026

# ------------------------------------------------------------------------------
# 5. Email Notification & OTP Authentication Service (Nodemailer)
# ------------------------------------------------------------------------------
# Option A: Gmail SMTP with 16-character App Password (recommended for quick setup)
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Option B: Custom Corporate SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ARCHGUARD AI Security" <security@archguard.ai>

# ------------------------------------------------------------------------------
# 6. Neon PostgreSQL Database (Production Persistence)
# ------------------------------------------------------------------------------
# Free Serverless PostgreSQL at https://neon.tech
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
SMTP_FROM="ARCHGUARD AI Security" <security@archguard.ai>
